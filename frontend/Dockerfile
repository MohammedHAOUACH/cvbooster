FROM node:20-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Inject env vars for build-time (needed for Next.js)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CALLBACK_URL
ARG NEXT_PUBLIC_SKIP_AUTH
ARG NEXT_PUBLIC_AUTH_PROVIDER
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CALLBACK_URL=$NEXT_PUBLIC_CALLBACK_URL
ENV NEXT_PUBLIC_SKIP_AUTH=$NEXT_PUBLIC_SKIP_AUTH
ENV NEXT_PUBLIC_AUTH_PROVIDER=$NEXT_PUBLIC_AUTH_PROVIDER
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Runtime env vars
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CALLBACK_URL
ARG NEXT_PUBLIC_SKIP_AUTH
ARG NEXT_PUBLIC_AUTH_PROVIDER
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CALLBACK_URL=$NEXT_PUBLIC_CALLBACK_URL
ENV NEXT_PUBLIC_SKIP_AUTH=$NEXT_PUBLIC_SKIP_AUTH
ENV NEXT_PUBLIC_AUTH_PROVIDER=$NEXT_PUBLIC_AUTH_PROVIDER

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
