# App Configuration
APP_NAME=CVBooster
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:80
DEBUG=false
# Set to true to disable authentication (dev mode), false to require login
SKIP_AUTH=false

# Database
DATABASE_PATH=/app/data/cvbooster.db

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://your-vps-ip/api/auth/google/callback

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=your-secret-key-here-change-in-production

# OpenRouter API (get free key from https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-xxx
USE_OPENROUTER=true
# Model to use (paid model - ~$0.20/M tokens)
# Other options: mistralai/mistral-7b-instruct, qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Local LLM (fallback if OpenRouter fails)
LOCAL_LLM_URL=http://host.docker.internal:1234
LOCAL_LLM_MODEL=Qwen3.6-27B-UD-Q5_K_XL.gguf

# Uploads
UPLOADS_DIR=/app/uploads
